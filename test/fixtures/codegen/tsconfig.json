{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": true,
    "checkJs": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": ["generated/**/*.js", "generated/**/*.d.ts", "consumer.ts"]
}

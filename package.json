{
  "name": "dextrin",
  "version": "0.1.0",
  "private": false,
  "author": "Jan Oetjen <oetjenj@gmail.com> (http://phexter.net)",
  "description": "DXN (Data eXchange Notation) for Node.js -- .dxn text, .dxnb binary, and .dxns schema documents.",
  "homepage": "https://github.com/joetjen/node-dextrin",
  "type": "module",
  "main": "./src/dextrin.cjs",
  "exports": {
    ".": {
      "import": "./src/dextrin.js",
      "require": "./src/dextrin.cjs",
      "default": "./src/dextrin.cjs"
    }
  },
  "bin": {
    "dextrin": "./bin/dextrin.js"
  },
  "files": [
    "src",
    "priv",
    "bin"
  ],
  "license": "MIT",
  "directories": {
    "src": "./src"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "auto-changelog": "^2.6.0",
    "chai": "^6.2.2",
    "fast-check": "^4.9.0",
    "mocha": "^11.7.6",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "test": "npx mocha --recursive test/",
    "autotest": "npx mocha --recursive --watch test/",
    "typecheck": "npx tsc --checkJs --noEmit",
    "precommit": "npm run typecheck && npm test",
    "docs": "npx typedoc",
    "version": "npx auto-changelog --package --template keepachangelog && git add CHANGELOG.md"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/joetjen/node-dextrin.git"
  },
  "bugs": {
    "url": "https://github.com/joetjen/node-dextrin/issues",
    "email": "oetjenj@gmail.com"
  },
  "keywords": [
    "dxn",
    "dextrin",
    "serialization",
    "cbor",
    "codec"
  ]
}

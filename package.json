{
  "name": "@joetjen/dextrin",
  "version": "0.3.2",
  "private": false,
  "author": "Jan Oetjen <joetjen.riveting388@passmail.net> (http://joetjen.net)",
  "description": "Under heavy development: not for production use before 1.0.0. DXN (Data eXchange Notation) for Node.js -- .dxn text, .dxnb binary, and .dxns schema documents.",
  "homepage": "https://github.com/joetjen/node-dextrin",
  "type": "module",
  "main": "./src/dextrin.cjs",
  "types": "./types/dextrin.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/dextrin.d.ts",
        "default": "./src/dextrin.js"
      },
      "require": {
        "types": "./types/dextrin.d.cts",
        "default": "./src/dextrin.cjs"
      },
      "default": "./src/dextrin.cjs"
    }
  },
  "bin": {
    "dextrin": "./bin/dextrin.js"
  },
  "files": [
    "src",
    "priv",
    "bin",
    "types"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "src": "./src"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "chai": "^6.2.2",
    "esbuild": "^0.24.2",
    "fast-check": "^3.23.0",
    "mocha": "^12.0.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "test": "npx mocha --recursive test/ --ignore 'test/fixtures/**'",
    "autotest": "npx mocha --recursive --watch test/ --ignore 'test/fixtures/**'",
    "typecheck": "npx tsc --checkJs --noEmit",
    "types": "rm -rf types && tsc -p tsconfig.types.json",
    "typecheck:consumer": "npm run types && tsc -p test/types/tsconfig.json",
    "prepack": "npm run types",
    "precommit": "npm run typecheck && npm run typecheck:consumer && npm test",
    "docs": "npx typedoc",
    "std": "node scripts/std-source.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/joetjen/node-dextrin.git"
  },
  "bugs": {
    "url": "https://github.com/joetjen/node-dextrin/issues",
    "email": "joetjen.riveting388@passmail.net"
  },
  "keywords": [
    "dxn",
    "dextrin",
    "serialization",
    "cbor",
    "codec"
  ]
}
